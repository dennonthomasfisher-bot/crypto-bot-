# ─────────────────────────────────────────────────────────────────────────────
# Crypto News Bot – environment variables
# Copy this file to .env and fill in the values.
# ─────────────────────────────────────────────────────────────────────────────

# ── Twitter / X Developer credentials ────────────────────────────────────────
# Get these from https://developer.twitter.com/en/portal/dashboard
# Your app needs "Read & Write" OAuth 1.0a permissions.
TWITTER_API_KEY=your_api_key_here
TWITTER_API_SECRET=your_api_secret_here
TWITTER_ACCESS_TOKEN=your_access_token_here
TWITTER_ACCESS_TOKEN_SECRET=your_access_token_secret_here
TWITTER_BEARER_TOKEN=your_bearer_token_here   # optional, needed for read/search ops

# ── CryptoPanic API key (free) ────────────────────────────────────────────────
# Sign up at https://cryptopanic.com/accounts/signup/
# Then find your key at https://cryptopanic.com/developers/api/
CRYPTOPANIC_API_KEY=your_cryptopanic_api_key_here

# ── Anthropic API (for AI-generated tweets) ──────────────────────────────────
# Get your key at https://console.anthropic.com/settings/keys
# Optional — without this the bot uses template-based tweets instead.
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ── Discord webhook (optional) ────────────────────────────────────────────────
# Create a webhook in your Discord server: Server Settings → Integrations → Webhooks
DISCORD_WEBHOOK_URL=

# ── Telegram bot (optional) ──────────────────────────────────────────────────
# Create a bot via @BotFather, get the token, then add bot to your group/channel
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Crypto.com Exchange API (for trading bot) ────────────────────────────────
# Get these from https://crypto.com/exchange → Settings → API Keys
EXCHANGE_API_KEY=your_exchange_api_key_here
EXCHANGE_API_SECRET=your_exchange_api_secret_here
