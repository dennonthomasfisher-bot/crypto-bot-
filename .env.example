# ─────────────────────────────────────────────────────────────────────────────
# Crypto News Bot – environment variables
# Copy this file to .env and fill in the values.
# ─────────────────────────────────────────────────────────────────────────────

# ── Twitter / X Developer credentials ────────────────────────────────────────
# Get these from https://developer.twitter.com/en/portal/dashboard
# Your app needs "Read & Write" OAuth 1.0a permissions.
TWITTER_API_KEY=your_api_key_here
TWITTER_API_SECRET=your_api_secret_here
TWITTER_ACCESS_TOKEN=your_access_token_here
TWITTER_ACCESS_TOKEN_SECRET=your_access_token_secret_here
TWITTER_BEARER_TOKEN=your_bearer_token_here   # optional, needed for read ops
# Kill-switch: set to false to skip all X posting while keeping Telegram + Bluesky mirrors live.
TWITTER_ENABLED=true

# ── Anthropic / Claude API key ────────────────────────────────────────────────
# Get your key at https://console.anthropic.com/
# Used for AI-written news tweets and the daily 08:00 UK morning recap.
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ── Telegram channel mirror ──────────────────────────────────────────────────
# Every tweet is mirrored to a Telegram channel for cross-platform distribution.
# 1. Create a bot with @BotFather on Telegram, copy the token below.
# 2. Create a public channel, add the bot as admin with "Post Messages" rights.
# 3. Set TELEGRAM_CHANNEL_ID to the channel username (e.g. @cryptovault88).
# Set TELEGRAM_ENABLED=false to disable the mirror without removing creds.
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHANNEL_ID=@your_channel_username
TELEGRAM_ENABLED=true
# Optional: route internal health alerts to a private chat instead of the
# public subscriber channel. Get your personal chat id by messaging the bot
# first, then visiting https://api.telegram.org/bot<TOKEN>/getUpdates and
# copying the "chat.id" value. Leave blank to fall back to the main channel.
TELEGRAM_ALERT_CHAT_ID=

# ── Bluesky mirror ───────────────────────────────────────────────────────────
# Every tweet is mirrored to a Bluesky account (AT Protocol).
# 1. Sign up at https://bsky.app — pick a handle like cryptovault88.bsky.social
# 2. Settings → Privacy and security → App Passwords → Add App Password
#    (never use your main login password here; app passwords can be revoked)
# 3. BLUESKY_HANDLE is the full handle (with .bsky.social suffix).
# Set BLUESKY_ENABLED=false to disable the mirror without removing creds.
BLUESKY_HANDLE=your_handle.bsky.social
BLUESKY_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx
BLUESKY_ENABLED=true

# ── NewsAPI.org API key ───────────────────────────────────────────────────────
# Sign up at https://newsapi.org/ to get a free API key.
NEWS_API_KEY=cb9aa26e4d7e45809bd6757337d5669e

# ── Crypto.com Exchange API credentials ──────────────────────────────────────
CRYPTO_COM_API_KEY=ROTATE_ME
CRYPTO_COM_API_SECRET=ROTATE_ME

# ── Reply engine ─────────────────────────────────────────────────────────────
REPLY_ACCOUNTS=WatcherGuru,unusual_whales,tier10k,CryptoSlate,coindesk,CoinDesk,Cointelegraph,TheBlock__,WuBlockchain,DeItaone
MAX_REPLIES_PER_HOUR=3
REPLY_MIN_GAP_SECONDS=240
