# ─────────────────────────────────────────────────────────────────────────────
# Crypto Trading Bot – configuration template
# Copy this file to .env and fill in your values.
# Never commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Crypto.com Exchange API ───────────────────────────────────────────────────
# Create keys at: https://crypto.com/exchange/user/api-management
CRYPTO_COM_API_KEY=your_api_key_here
CRYPTO_COM_API_SECRET=your_api_secret_here

# ── Operation mode ────────────────────────────────────────────────────────────
# true  = no real orders placed (safe to test)
# false = LIVE TRADING with real money – use with caution!
DRY_RUN=true

# ── Trading pairs (comma-separated Crypto.com instrument names) ───────────────
TRADING_PAIRS=BTC_USDT,ETH_USDT,SOL_USDT,BNB_USDT,XRP_USDT,ADA_USDT,AVAX_USDT,DOGE_USDT,DOT_USDT,MATIC_USDT

# ── Risk management ───────────────────────────────────────────────────────────
DAILY_SPEND_CAP=100        # Hard ceiling: max USD to deploy across all trades in a calendar day
MAX_PER_TRADE=25           # Max USD for a single market order
MAX_POSITION_PCT=0.10      # Max fraction of available USDT balance per position (0.10 = 10%)
STOP_LOSS_PCT=0.05         # Exit when price drops 5% below entry
TAKE_PROFIT_PCT=0.08       # Exit when price rises 8% above entry

# ── RSI strategy ──────────────────────────────────────────────────────────────
RSI_PERIOD=14              # Lookback period for RSI calculation
RSI_OVERSOLD=30            # RSI ≤ this value → buy signal
RSI_OVERBOUGHT=70          # RSI ≥ this value → sell signal

# ── Momentum / breakout strategy ──────────────────────────────────────────────
MOMENTUM_PERIOD=20         # Number of historical candles defining the reference high
MOMENTUM_THRESHOLD=0.03    # Price must exceed the period high by this fraction (0.03 = 3%)

# ── DCA strategy ──────────────────────────────────────────────────────────────
DCA_INTERVAL_HOURS=24      # Hours between automatic DCA buys
DCA_PAIRS=BTC_USDT,ETH_USDT,SOL_USDT   # Pairs to DCA into (subset of TRADING_PAIRS)
DCA_AMOUNT_USD=10          # Fixed USD amount per DCA buy

# ── Signal aggregation ────────────────────────────────────────────────────────
# Combined score range is approximately [-1.0, +1.0]
SIGNAL_BUY_THRESHOLD=0.30   # Score must reach this to trigger a discretionary BUY
SIGNAL_SELL_THRESHOLD=-0.30 # Score must fall to this to trigger a SELL

# ── Polling ───────────────────────────────────────────────────────────────────
POLL_INTERVAL_SECONDS=60   # How often to evaluate all pairs (seconds)

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO             # DEBUG | INFO | WARNING | ERROR
