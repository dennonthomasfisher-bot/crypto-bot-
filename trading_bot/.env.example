# ─────────────────────────────────────────────────────────────────────────────
# Crypto Trading Bot – configuration template
# Copy this file to .env and fill in your values.
# Never commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Crypto.com Exchange API ───────────────────────────────────────────────────
# Create keys at: https://crypto.com/exchange/user/api-management
CRYPTO_COM_API_KEY=your_api_key_here
CRYPTO_COM_API_SECRET=your_api_secret_here

# ── Operation mode ────────────────────────────────────────────────────────────
# true  = no real orders placed (safe to test)
# false = LIVE TRADING with real money – use with caution!
DRY_RUN=true

# ── Trading pairs (comma-separated Crypto.com instrument names) ───────────────
TRADING_PAIRS=BTC_USDT,ETH_USDT,SOL_USDT,XRP_USDT,ADA_USDT,AVAX_USDT,DOGE_USDT,DOT_USDT

# ── Weekly capital cycle ──────────────────────────────────────────────────────
# Every Monday at 00:01 the bot resets to this deposit amount.
# If last week was profitable, profits are carried forward (compounded).
# If last week was a loss, the bot starts fresh at this amount (no compounding losses).
WEEKLY_DEPOSIT=100.0

# ── Risk management ───────────────────────────────────────────────────────────
MAX_PER_TRADE=75           # Hard ceiling per single order (USD)
STOP_LOSS_PCT=0.07         # Exit when price drops 7% below entry (wider = fewer false stops)
TAKE_PROFIT_PCT=0.06       # Exit when price rises 6% above entry (tighter = hits more often)

# ── Trailing stop ─────────────────────────────────────────────────────────────
# Once a position is up TRAILING_BREAKEVEN_PCT, the stop moves to entry (can't lose).
# Once up TRAILING_TRIGGER_PCT, the stop trails TRAILING_DISTANCE_PCT below the peak.
TRAILING_BREAKEVEN_PCT=0.03   # Move stop to breakeven once up 3%
TRAILING_TRIGGER_PCT=0.05     # Start trailing stop once up 5%
TRAILING_DISTANCE_PCT=0.02    # Trail 2% below the highest price seen

# ── Daily loss limit ──────────────────────────────────────────────────────────
# If daily realised losses exceed this fraction of weekly capital, pause new BUYs until midnight.
# e.g. 0.05 = 5% of $100 = $5 daily loss limit
DAILY_LOSS_LIMIT_PCT=0.05

# ── RSI strategy ──────────────────────────────────────────────────────────────
RSI_PERIOD=14              # Lookback period for RSI calculation
RSI_OVERSOLD=45            # RSI ≤ this value → buy signal (45 fires more often than 30)
RSI_OVERBOUGHT=70          # RSI ≥ this value → sell signal

# ── Momentum / breakout strategy ──────────────────────────────────────────────
MOMENTUM_PERIOD=3          # 3-bar lookback: fires in sideways/ranging markets
MOMENTUM_THRESHOLD=0.005   # 0.5% breakout required (was 3% — too tight for intraday)

# ── EMA crossover strategy ────────────────────────────────────────────────────
EMA_FAST=8
EMA_SLOW=21

# ── Bollinger Bands strategy ───────────────────────────────────────────────────
BB_PERIOD=20
BB_STD=2.0

# ── Volume surge strategy ──────────────────────────────────────────────────────
VOL_PERIOD=20
VOL_THRESHOLD=1.2          # Volume must be 1.2× the average to count as a surge

# ── Signal aggregation ────────────────────────────────────────────────────────
# Combined score range is approximately [-1.0, +1.0]
SIGNAL_BUY_THRESHOLD=0.10   # Minimum score to trigger a BUY
SIGNAL_SELL_THRESHOLD=-0.30 # Score must fall to this to trigger a SELL
MIN_BUY_SIGNALS=3           # At least 3 of 5 signals must be bullish to BUY

# ── Polling ───────────────────────────────────────────────────────────────────
POLL_INTERVAL_SECONDS=60   # How often to evaluate all pairs (seconds)

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO             # DEBUG | INFO | WARNING | ERROR
